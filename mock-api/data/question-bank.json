  "risk_rules": [
    {
      "id": "RR01",
      "name": "特殊人群与高风险用药",
      "min_level": "B",
      "description": "涉及孕妇、备孕、哺乳期、严重肝肾功能不全、透析、器官移植、肿瘤、免疫抑制、抗凝、胰岛素、抗癫痫或精神类药物时，至少按 B 级审核，必要时按 C 级。",
      "tags": [
        "pregnancy",
        "preconception",
        "lactation",
        "severe_hepatic_renal_impairment",
        "dialysis",
        "transplant",
        "oncology",
        "immunosuppression",
        "anticoagulant",
        "insulin",
        "antiepileptic",
        "psychiatric_medication"
      ]
    },
    {
      "id": "RR02",
      "name": "严重程度升级",
      "min_level": "B",
      "description": "用药过量、不良反应、禁忌和相互作用的一般事实核对可为 A 级；需要判断是否就医、停药或存在严重后果时升级为 B/C 级。",
      "tags": [
        "severe_overdose",
        "serious_adverse_reaction",
        "high_risk_contraindication",
        "serious_drug_interaction",
        "medical_triage",
        "stop_medication_judgment"
      ]
    },
    {
      "id": "RR03",
      "name": "医嘱与说明书冲突",
      "min_level": "B",
      "description": "涉及处方医嘱与说明书不一致时，不按普通说明书问答处理，至少按 B 级审核。",
      "tags": [
        "prescription_label_conflict"
      ]
    },
    {
      "id": "RR04",
      "name": "剂量换算与高风险操作",
      "min_level": "B",
      "description": "涉及剂量换算、儿童体重剂量、分片、浓度、注射剂、吸入装置、贴剂、滴眼或滴耳等操作风险时升级为 B 级；高警示药或儿童精确剂量升级为 C 级。",
      "tag_levels": {
        "pediatric_exact_dose": "C",
        "high_alert_medication": "C"
      },
      "tags": [
        "dose_calculation",
        "pediatric_exact_dose",
        "tablet_splitting",
        "concentration_conversion",
        "injection",
        "inhaler",
        "patch",
        "eye_drop",
        "ear_drop",
        "high_alert_medication"
      ]
    },
    {
      "id": "RR05",
      "name": "治疗决策越权检查",
      "min_level": "A",
      "description": "涉及推荐药、换药、停药、加量、减量或替代品牌时，AI 不应直接给出治疗决策，审核时重点检查是否越权。",
      "tags": [
        "drug_recommendation",
        "drug_substitution",
        "stop_medication",
        "dose_increase",
        "dose_decrease",
        "brand_substitution"
      ]
    }
  ],
  "question_types": [
    {
      "code": "A01",
      "name": "药品基本属性",
      "base_level": "A",
      "typical_question": "这个药是治什么的？",
      "review_focus": "核对通用名、商品名、规格、性状、药理类别和适应症原文，不扩大治疗范围。",
      "default_risk_tags": [
        "fact_check",
        "drug_attribute"
      ]
    },
    {
      "code": "A02",
      "name": "适应症/功能主治事实核对",
      "base_level": "A",
      "typical_question": "这个药主要用于什么病？",
      "review_focus": "仅核对说明书适应症或数据库 indication，不判断个体是否适合使用。",
      "default_risk_tags": [
        "fact_check",
        "indication"
      ]
    },
    {
      "code": "A03",
      "name": "用法用量",
      "base_level": "A",
      "typical_question": "一天吃几次？每次多少？",
      "review_focus": "核对剂量、频次、给药途径和最大日剂量；有处方医嘱时优先核对医嘱。",
      "default_risk_tags": [
        "dosage",
        "prescription_order"
      ]
    },
    {
      "code": "A04",
      "name": "服用时间",
      "base_level": "A",
      "typical_question": "饭前吃还是饭后吃？",
      "review_focus": "核对说明书或医嘱中的服用时间；资料未明确时不得推断。",
      "default_risk_tags": [
        "administration_time"
      ]
    },
    {
      "code": "A05",
      "name": "给药方式/操作方法",
      "base_level": "A",
      "typical_question": "眼药水怎么滴？",
      "review_focus": "核对给药步骤、部位、频次和清洁要求；复杂器械操作可升级为 B 级。",
      "default_risk_tags": [
        "administration_operation"
      ]
    },
    {
      "code": "A06",
      "name": "疗程与起效时间",
      "base_level": "A",
      "typical_question": "要吃多久？多久见效？",
      "review_focus": "核对疗程、起效时间或复诊提示；资料未提供时提示遵医嘱。",
      "default_risk_tags": [
        "treatment_course",
        "onset_time"
      ]
    },
    {
      "code": "A07",
      "name": "忘记/漏服用药",
      "base_level": "A",
      "typical_question": "漏服一次怎么办？",
      "review_focus": "核对补服或跳过原则、时间窗口和是否禁止加倍补服。",
      "default_risk_tags": [
        "missed_dose"
      ]
    },
    {
      "code": "A08",
      "name": "一般用药过量",
      "base_level": "A",
      "typical_question": "多吃了一片怎么办？",
      "review_focus": "核对说明书过量处理原则；出现明显症状或涉及高危药品时升级为 B/C 级。",
      "default_risk_tags": [
        "general_overdose"
      ]
    },
    {
      "code": "A09",
      "name": "提前停药/减量",
      "base_level": "A",
      "typical_question": "感觉好了能停药吗？",
      "review_focus": "核对疗程要求和擅自停药风险；抗感染、激素、精神类等用药需升级。",
      "default_risk_tags": [
        "stop_medication",
        "dose_decrease"
      ]
    },
    {
      "code": "A10",
      "name": "饮食与生活方式",
      "base_level": "A",
      "typical_question": "吃药期间能喝酒吗？",
      "review_focus": "核对酒精、食物、咖啡因、驾驶和运动等注意事项。",
      "default_risk_tags": [
        "food_interaction",
        "lifestyle"
      ]
    },
    {
      "code": "A11",
      "name": "一般不良反应",
      "base_level": "A",
      "typical_question": "吃了有点恶心正常吗？",
      "review_focus": "核对常见不良反应，确保描述准确且不遗漏就医提示。",
      "default_risk_tags": [
        "general_adverse_reaction"
      ]
    },
    {
      "code": "A12",
      "name": "一般注意事项",
      "base_level": "A",
      "typical_question": "吃这个药要注意什么？",
      "review_focus": "核对说明书注意事项，转为患者可读摘要，不新增说明书外内容。",
      "default_risk_tags": [
        "precaution",
        "fact_check"
      ]
    },
    {
      "code": "A13",
      "name": "储藏方式",
      "base_level": "A",
      "typical_question": "这个药怎么保存？",
      "review_focus": "核对温度、避光、防潮、冷藏、有效期和开封后保存要求。",
      "default_risk_tags": [
        "storage"
      ]
    },
    {
      "code": "A14",
      "name": "包装/规格/性状",
      "base_level": "A",
      "typical_question": "一盒多少片？",
      "review_focus": "核对规格、包装、性状和最小单位，避免与其他厂家混淆。",
      "default_risk_tags": [
        "package_specification",
        "drug_attribute"
      ]
    },
    {
      "code": "A15",
      "name": "科室归属",
      "base_level": "A",
      "typical_question": "这个药通常属于哪个科室？",
      "review_focus": "核对适应症和常见使用场景，返回一个或多个科室 code，不作为诊断建议。",
      "default_risk_tags": [
        "department_mapping"
      ]
    },
    {
      "code": "B01",
      "name": "是否适合当前患者",
      "base_level": "B",
      "typical_question": "我这个症状适合吃吗？",
      "review_focus": "区分说明书适应症与患者自述症状，避免把药品推荐成诊断或治疗方案。",
      "default_risk_tags": [
        "patient_suitability",
        "drug_recommendation"
      ]
    },
    {
      "code": "B02",
      "name": "慎用人群/基础疾病",
      "base_level": "B",
      "typical_question": "有高血压、糖尿病或胃病能吃吗？",
      "review_focus": "核对慎用、禁忌和注意事项；涉及合并症时判断是否需要医生确认。",
      "default_risk_tags": [
        "comorbidity",
        "caution_contraindication"
      ]
    },
    {
      "code": "B03",
      "name": "肝肾功能异常",
      "base_level": "B",
      "typical_question": "肾不好能吃吗？",
      "review_focus": "核对肝肾功能调整、禁用或慎用条件及监测要求。",
      "default_risk_tags": [
        "hepatic_renal_impairment"
      ]
    },
    {
      "code": "B04",
      "name": "儿童/青少年用药",
      "base_level": "B",
      "typical_question": "小孩能吃吗？",
      "review_focus": "核对年龄、体重、剂型和剂量；按体重精确换算或超说明书时升级为 C 级。",
      "default_risk_tags": [
        "pediatric"
      ]
    },
    {
      "code": "B05",
      "name": "老年人用药",
      "base_level": "B",
      "typical_question": "老人能吃吗？",
      "review_focus": "核对老年用药专节、肝肾功能减退及跌倒、嗜睡、出血等风险。",
      "default_risk_tags": [
        "geriatric"
      ]
    },
    {
      "code": "B06",
      "name": "严重不良反应识别",
      "base_level": "B",
      "typical_question": "出现什么情况要马上去医院？",
      "review_focus": "区分常见反应与严重反应，核对停药和就医信号。",
      "default_risk_tags": [
        "serious_adverse_reaction",
        "medical_triage"
      ]
    },
    {
      "code": "B07",
      "name": "检查监测/复查",
      "base_level": "B",
      "typical_question": "吃药期间要查什么？",
      "review_focus": "核对血常规、肝肾功能、凝血、血糖、甲功或血药浓度等监测要求。",
      "default_risk_tags": [
        "monitoring"
      ]
    },
    {
      "code": "B08",
      "name": "医嘱与说明书不一致",
      "base_level": "B",
      "typical_question": "医生开的和说明书不同，听谁的？",
      "review_focus": "核对医嘱优先边界，不擅自否定处方，提示联系开方医生或药师确认。",
      "default_risk_tags": [
        "prescription_label_conflict"
      ]
    },
    {
      "code": "B09",
      "name": "多主题组合问题",
      "base_level": "B",
      "typical_question": "怎么吃？有什么副作用？老人能不能吃？",
      "review_focus": "拆分主题分别审核，确保用法、风险和人群判断不相互混淆。",
      "default_risk_tags": [
        "multi_topic"
      ]
    },
    {
      "code": "B10",
      "name": "重复用药/同成分识别",
      "base_level": "B",
